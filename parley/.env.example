# Copy to .env (same folder) and fill in. Never commit .env.
GEMINI_API_KEY=
# Gemma 4 on the Gemini API: gemma-4-26b-a4b-it (faster) or gemma-4-31b-it
GEMMA_MODEL=gemma-4-26b-a4b-it
# Gemma 4 thinking level: minimal (~1 s/call, default) or high (~8 s/call)
# GEMMA_THINKING=minimal
# Backend: claude (local Claude Code CLI, for dev/testing) | gemma (demo) | mock (offline, deterministic)
# LLM_MODE=claude
# Claude Code model for dev: haiku (fast) | sonnet | opus
# CLAUDE_MODEL=haiku
